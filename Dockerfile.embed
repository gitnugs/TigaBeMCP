# TigaBe Embedding — multilingual-e5-small (FastAPI)
FROM python:3.13-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    HF_HUB_OFFLINE=1 \
    HF_HOME=/models

WORKDIR /app

# torch/sentence-transformers (CPU) — image kecil, build cepat
COPY requirements-embed.txt ./requirements.txt
# pasang torch CPU lebih dulu agar sentence-transformers TIDAK menarik torch CUDA
RUN pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu
RUN pip install --no-cache-dir -r requirements.txt

COPY embed_service.py embedding_lokal.py entrypoint.sh ./
RUN chmod +x /app/entrypoint.sh

# Prefetch model E5 SAAT BUILD (internet tersedia). Disimpan di /models_baked
# (BUKAN /models) agar saat runtime named volume `tigabe-models:/models`
# menutupi isi image, model hasil bake tidak hilang. Entrypoint akan
# menyalin /models_baked -> /models hanya bila volume masih kosong.
ENV HF_HUB_OFFLINE=0
RUN python -c "from sentence_transformers import SentenceTransformer; m=SentenceTransformer('intfloat/multilingual-e5-small', cache_folder='/models_baked', device='cpu'); print('MODEL PREFETCH OK dim', m.get_sentence_embedding_dimension())"

EXPOSE 18110

ENTRYPOINT ["/app/entrypoint.sh"]
CMD ["uvicorn", "embed_service:app", "--host", "0.0.0.0", "--port", "18110"]