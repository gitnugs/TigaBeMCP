# TigaBe MCP — server + login + admin + pengetahuan
FROM python:3.13-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

# tesseract OCR (+ data bahasa Indonesia) untuk PDF hasil scan tanpa teks
RUN apt-get update && apt-get install -y --no-install-recommends \
        tesseract-ocr tesseract-ocr-ind \
    && rm -rf /var/lib/apt/lists/*

# dependensi lebih dulu agar layer di-cache saat kode berubah
COPY requirements-mcp.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

# kode aplikasi (requirements.txt repo TIDAK ikut — berisi torch)
COPY server.py auth.py oauth_provider.py search.py storage.py embedding.py \
     knowledge.py ingest.py audit.py admin_page.py pengetahuan_ui.py \
     html_theme.py ./
COPY scripts/ ./scripts/
COPY .env.example ./

# .env / roles.json / login_users.json / audit_log.json TIDAK di-bake;
# pasang lewat volume/secret saat run.

EXPOSE 18105

# host 0.0.0.0 agar bisa dipanggil dari container lain / reverse proxy
ENV MCP_HOST=0.0.0.0 \
    MCP_PORT=18105

CMD ["python", "server.py"]